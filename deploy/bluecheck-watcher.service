[Unit]
Description=Theo doi tick xanh Facebook (doc profile cong khai, day ket qua len Worker)
Documentation=https://shop-dashboard.nguyenkhang170855.workers.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bluecheck
Environment="PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright"
Environment="PYTHONIOENCODING=utf-8"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/bluecheck/venv/bin/python /opt/bluecheck/watcher.py
Restart=always
RestartSec=30

# Hardening: watcher chi can doc trang cong khai va ghi 1 file local.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bluecheck

[Install]
WantedBy=multi-user.target
